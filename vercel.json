{
  "env": {
    "PYTHONPATH": "."
  },
  "functions": {
    "app.py": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron/refresh",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/refresh-rss",
      "schedule": "0 14 * * *"
    },
    {
      "path": "/api/cron/weekly-intelligence",
      "schedule": "0 8 * * 1"
    }
  ]
}
