# Copy this file to .env and paste your real keys (one time setup).
# The start.ps1 script loads these automatically — no need to type keys every time.

# Google Gemini — news classification + PDF/image newspaper reading only
GEMINIAPIKEY=your-gemini-key-here
# Optional alias used by docs: NEWS_GEMINI_API_KEY can point to the same news key
# NEWS_GEMINI_API_KEY=your-gemini-key-here

# Google Gemini — Intelligence Hub weekly briefs ONLY (create a SECOND key at aistudio.google.com)
# Never falls back to GEMINIAPIKEY, so news processing and intelligence do not share quota.
INTELLIGENCE_GEMINI_API_KEY=your-intelligence-gemini-key-here
# Optional: Flash-only model list (defaults are already Flash, not Pro)
# INTELLIGENCE_GEMINI_MODELS=gemini-3-flash-preview,gemini-2.0-flash
# INTELLIGENCE_ARTICLE_CAP=24
# INTELLIGENCE_SUMMARY_CHARS=360

NEWSAPIKEY=your-newsapi-key-here
GNEWSAPIKEY=your-gnews-key-here
GEMINI_SSL_VERIFY=false

# Apify — Instagram scraping (free tier token from https://console.apify.com)
# APIFY_TOKEN=your-apify-token
# APIFY_INSTAGRAM_ACTOR=apify~instagram-scraper
# Optional Excel column remap after you share your template, e.g.:
# INSTAGRAM_EXCEL_COLUMNS=handle:Brand,post_url:Link,caption:Caption,posted_date:Date,summary:Notes,image_url:Image

# LinkedIn festive discovery (does NOT use NewsAPI / GNews quotas)
# Preferred: ScrapeGraphAI Search API — https://scrapegraphai.com (fresh posts, past_week)
# SGAI_API_KEY=sgai-...
# Fallback / alternative: reuse APIFY_TOKEN with LinkedIn post search actor
# APIFY_LINKEDIN_ACTOR=harvestapi~linkedin-post-search
# LINKEDIN_APIFY_POSTED_LIMIT=week
# LINKEDIN_MAX_AGE_DAYS=14
# LINKEDIN_PROVIDERS=scrapegraph,apify,rss
# Last resort only: Google News RSS (often stale) with when:Nd filter

# Durable DB on Vercel (RECOMMENDED — avoids Blob free-limit data loss)
# Create free DB at https://turso.tech → copy URL + token into Vercel env, then redeploy.
# Real values from Turso dashboard only — never paste placeholders like .... or your_token_here
# TURSO_DATABASE_URL=libsql://insights-hour-xxxx.aws-ap-south-1.turso.io
# TURSO_AUTH_TOKEN=eyJhbGciOiJFZERTQSIsInR5cCI6IkpXVCJ9...

# Durable SQLite on Render/Railway (optional alternative to Turso)
# PERSISTENT_DISK_PATH=/var/data
# RAILWAY_VOLUME_MOUNT_PATH=/data
# DATABASE_PATH=/var/data/news.db

# Email (required for Send Email button)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=your-email@gmail.com
SMTP_USE_TLS=true

# Backend Management password (required on Vercel / public hosting)
ADMIN_PASSWORD=choose-a-strong-password-here

# Public URL for unsubscribe / preferences links in emails
# APP_BASE_URL=https://your-insights-hour.vercel.app

# Optional: Vercel Cron auth (Settings → Environment Variables).
# When set, Vercel sends Authorization: Bearer <CRON_SECRET> on scheduled runs.
# CRON_SECRET=generate-a-long-random-string

# Optional: paste sector_recipients.json content on Vercel (single line JSON)
# SECTOR_RECIPIENTS_JSON={"ride_hailing":["you@company.com"]}

# Optional tuning (defaults are fine for most users)
# GEMINI_MAX_ARTICLES=80
# GEMINI_MAX_DAYS=7
# GEMINI_ORIGINS=epub,newspaper
# RSS is free — hourly via GitHub Actions → /api/cron/refresh-hourly
# RSS_REFRESH_HOURS=1
# GNews / NewsAPI metered — every ~3 hours via /api/cron/refresh-metered
# GNEWS_REFRESH_HOURS=3
# NEWSAPI_REFRESH_HOURS=3
# Hourly Gemini summarizes FESTIVE SALE only
# HOURLY_FESTIVE_GEMINI_LIMIT=12
# GOOGLE_NEWS_MAX_ITEMS=18
# GOOGLE_NEWS_ARTICLE_CAP=35
# GOOGLE_NEWS_RSS=true

# Vercel only — REQUIRED so news survives overnight (Storage → Blob → connect to project).
# Vercel sets these automatically when Blob store is linked:
#   BLOB_READ_WRITE_TOKEN
#   BLOB_STORE_ID
# DATABASE_BLOB_PATH=insights-hour/news.db
